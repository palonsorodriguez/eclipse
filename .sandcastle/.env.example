# Copy to .sandcastle/.env for local runs (npm run sandcastle).
# In GitHub Actions these come from repository secrets instead.

# Auth for Claude Code. Generate with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative to the OAuth token — pay-per-use API billing.
ANTHROPIC_API_KEY=

# GitHub token the agent uses for `gh` commands inside the sandbox.
GH_TOKEN=
